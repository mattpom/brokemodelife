            "label": "Use Mutual TLS"
          }
        ]
      }
    },
    {
      "id": 5,
      "module": "builtin:BasicFilter",
      "version": 1,
      "parameters": {},
      "filter": {
        "name": "Link Failed",
        "conditions": [
          [
            {
              "a": "{{4.statusCode}}",
              "b": "200",
              "o": "notequal:string"
            }
          ]
        ]
      },
      "metadata": {
        "designer": {
          "x": 1200,
          "y": 0
        }
      }
    },
    {
      "id": 6,
      "module": "gmail:ActionSendEmail",
      "version": 1,
      "parameters": {
        "account": 0
      },
      "mapper": {
        "to": "{{owner}}",
        "subject": "🚨 Broken Affiliate Link Detected: {{3.product}}",
        "content": "<h2>Broken Affiliate Link Alert</h2><p><strong>Product:</strong> {{3.product}}</p><p><strong>ASIN:</strong> {{3.asin}}</p><p><strong>URL:</strong> {{3.url}}</p><p><strong>Status Code:</strong> {{4.statusCode}}</p><p>Please update this link in the affiliate-link-checker.json and on the site HTML.</p>",
        "contentType": "html",
        "from": "",
        "cc": "",
        "bcc": "",
        "attachments": []
      },
      "metadata": {
        "designer": {
          "x": 1500,
          "y": 0
        },
        "restore": {
          "parameters": {
            "account": {
              "label": "Connect Gmail"
            }
          }
        },
        "parameters": [
          {
            "name": "account",
            "type": "account:google",
            "label": "Connection",
            "required": true
          }
        ],
        "expect": [
          {
            "name": "to",
            "type": "email",
            "label": "To",
            "required": true
          },
          {
            "name": "subject",
            "type": "text",
            "label": "Subject"
          },
          {
            "name": "content",
            "type": "text",
            "label": "Content"
          },
          {
            "name": "contentType",
            "type": "select",
            "label": "Content type"
          },
          {
            "name": "from",
            "type": "email",
            "label": "From"
          },
          {
            "name": "cc",
            "type": "email",
            "label": "CC"
          },
          {
            "name": "bcc",
            "type": "email",
            "label": "BCC"
