            "label": "Password"
          },
          {
            "name": "timeout",
            "type": "uinteger",
            "label": "Timeout"
          },
          {
            "name": "shareCookies",
            "type": "boolean",
            "label": "Share cookies with other HTTP modules"
          },
          {
            "name": "ca",
            "type": "cert",
            "label": "Self-signed certificate"
          },
          {
            "name": "rejectUnauthorized",
            "type": "boolean",
            "label": "Reject connections that are using unverified/invalid certificates"
          },
          {
            "name": "followRedirect",
            "type": "boolean",
            "label": "Follow redirect"
          },
          {
            "name": "useQuerystring",
            "type": "boolean",
            "label": "Disable serialization of multiple same query string keys as arrays"
          },
          {
            "name": "gzip",
            "type": "boolean",
            "label": "Request compressed content"
          },
          {
            "name": "useMtls",
            "type": "boolean",
            "label": "Use Mutual TLS"
          }
        ]
      }
    },
    {
      "id": 2,
      "module": "util:FunctionSleep",
      "version": 1,
      "parameters": {},
      "mapper": {
        "delay": 1
      },
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0
        },
        "expect": [
          {
            "name": "delay",
            "type": "uinteger",
            "label": "Delay (ms)",
            "required": true
          }
        ]
      }
    },
    {
      "id": 3,
      "module": "builtin:BasicFeeder",
      "version": 1,
      "parameters": {},
      "mapper": {
        "array": "{{map(map(map(1.data.sites; \"pages\"); \"links\"); flatten)}}"
      },
      "metadata": {
        "designer": {
          "x": 600,
          "y": 0
        },
        "restore": {},
        "expect": [
          {
            "name": "array",
            "type": "array",
            "label": "Array",
            "required": true
          }
        ]
      }
    },
    {
      "id": 4,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": {
        "handleErrors": true,
        "useNewZLibDecompression": true
      },
      "mapper": {
        "url": "{{3.url}}",
        "serializeUrl": false,
        "method": "get",
        "headers": [],
        "qs": [],
        "authUser": "",
        "authPass": "",
        "bodyType": "",
        "parseResponse": false,
        "timeout": "10",
        "shareCookies": false,
        "ca": "",
        "rejectUnauthorized": true,
        "followRedirect": true,
        "useQuerystring": false,
        "gzip": true,
        "useMtls": false
      },
      "metadata": {
        "designer": {
          "x": 900,
          "y": 0
        },
        "restore": {
          "expect": {
            "method": {
              "mode": "chose",
              "label": "GET"
            }
          }
        },
        "parameters": [
          {
            "name": "handleErrors",
            "type": "boolean",
            "label": "Evaluate all states as errors (except for 2xx and 3xx)"
          },
          {
            "name": "useNewZLibDecompression",
            "type": "boolean",
            "label": "Use new ZLib decompression"
